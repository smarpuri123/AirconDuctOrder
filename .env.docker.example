# TEMPLATE ONLY — committed to git. On the VPS:
#   cp .env.docker.example .env.docker && nano .env.docker
# Never commit .env.docker or server/.env (see docs/GITHUB_ACTIONS_VPS.md).
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.docker up -d

POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d

# Must match how users open the site (no trailing slash)
CORS_ORIGIN=http://94.136.190.140

HTTP_PORT=80

# Set true only on first deploy, then back to false
RUN_DB_SEED=true

# Optional Web Push (HTTPS required in browsers)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@ecovent.com
