# Copy to server/.env
# Port 5433 on this machine (see LOCAL_DEV.md) — use 5432 if Postgres is on default port
DATABASE_URL=postgresql://ecovent:ecovent_dev@localhost:5433/ecovent_ops?schema=public
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ecovent.com
