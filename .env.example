# Frontend — copy to .env in project root
# Demo mode (default) — mock data, no backend
VITE_USE_API=false

# API mode — local PostgreSQL + Fastify server
# VITE_USE_API=true
# VITE_API_URL=/api

# ─── Local setup (no Docker) — see LOCAL_DEV.md ────────────────────────────
# Uses the same native PostgreSQL instance as pvsresponse (port 5433 here).
#
#   $env:PGPASSWORD="novaerp"
#   npm run db:setup -- -SkipInstall
#
#   copy .env.example .env
#   copy server\.env.example server\.env
#   # Set VITE_USE_API=true in .env
#
#   npm run dev:all
#   http://localhost:5173/login  →  admin@ecovent.com / Admin@123
#
# Re-seed:     npm run db:seed
# Schema sync: npm run db:push
# ───────────────────────────────────────────────────────────────────────────
#
# Optional Docker instead:
#   npm run db:up && npm run db:init
