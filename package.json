{
  "name": "aircon-duct-order",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "build:gh-pages": "tsc -b && cross-env GITHUB_PAGES=true vite build && node scripts/prepare-gh-pages.mjs",
    "preview": "vite preview",
    "preview:gh-pages": "cross-env GITHUB_PAGES=true vite build && node scripts/prepare-gh-pages.mjs && vite preview --base /AirconDuctOrder/",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist",
    "docs:pdf": "node scripts/generate-portal-pdf.mjs",
    "docs:mobile-pdf": "node scripts/generate-mobile-pdf.mjs",
    "docs:all": "node scripts/generate-portal-pdf.mjs && node scripts/generate-mobile-pdf.mjs",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "db:push": "npm run db:push --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:seed:demo": "npm run db:seed:demo --prefix server",
    "db:init": "npm run db:push && npm run db:seed:demo",
    "db:up": "docker compose up -d",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.docker down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.docker logs -f",
    "db:migrate": "npm run db:migrate --prefix server"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
